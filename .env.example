OPENAI_API_KEY=sk-your-key-here
SBA_MODEL=gpt-4o-mini
SBA_DAILY_LIMIT_PER_SITE=300
PORT=3000

# --- Stripe (one-off purchase + license issuance) ---------------------------
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/webhook` in dev, or the
# webhook endpoint config in the Stripe dashboard in prod.
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SBA=

# Public URL of this deployment (used in Stripe redirect URLs and in the
# download_url handed back by /updates/check).
APP_URL=http://localhost:3000
# Public Service Booking AI landing page. Stripe Checkout cancellations
# return the buyer here.
SITE_URL=https://bookingai.bluebootapps.com

# --- Self-hosted plugin updates ----------------------------------------------
# Shared secret for scripts/publish-update.mjs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UPDATE_ADMIN_SECRET=

# --- License email delivery --------------------------------------------------
# Sends the license key + download link by email right after purchase, as a
# backup to the thank-you page (which is the only delivery path if this is
# left unconfigured — checkout still works fine either way). Same
# support@bluebootapps.com mailbox Magpie's backend already sends from.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=support@bluebootapps.com
SMTP_PASSWORD=
EMAIL_FROM=support@bluebootapps.com

# --- Persistent storage -------------------------------------------------------
# Where usage.json, licenses.json, and updates/ live. In production this is
# bind-mounted outside the container (see custom_docker_run_options on the
# Coolify app) so it survives redeploys — without that mount, or locally,
# this just falls back to the container/repo's own ./data folder.
SBA_USAGE_DATA_DIR=
